# SHIFTWAVE AI Platform - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
DATABASE_URL=postgresql://aiagent:aiagent123@postgres:5432/ai_agent_db

# Security - CRITICAL: Change these in production!
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY_HERE
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# OLLAMA AI Service
OLLAMA_URL=http://ollama:11434

# CORS Configuration
CORS_ORIGINS=["*"]

# API Configuration
API_VERSION=1.0.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_BURST=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60
SECURITY_HEADERS_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=4
LOG_LEVEL=INFO
